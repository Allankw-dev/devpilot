# ---- General ----
PRODUCT_NAME="DevPilot AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- API ----
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ---- Database (docker-compose defaults) ----
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5433/devpilot

# ---- Redis ----
REDIS_URL=redis://localhost:6380/0

# ---- Supabase Auth (setup: docs/AUTH.md) ----
# Project URL, e.g. https://abcdefgh.supabase.co  (public value)
SUPABASE_URL=
# Legacy HS256 projects only. New projects verify tokens via JWKS and don't need this.
SUPABASE_JWT_SECRET=

# ---- GitHub App (setup: docs/GITHUB.md) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Full path to the downloaded .pem private key. Keep that file OUTSIDE this repo.
GITHUB_APP_PRIVATE_KEY_PATH=

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PRODUCT_NAME="DevPilot AI"
NEXT_PUBLIC_API_URL=http://localhost:8001
