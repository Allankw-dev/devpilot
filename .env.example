# ---- General ----
PRODUCT_NAME="DevPilot AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- API ----
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ---- Database (docker-compose defaults) ----
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5433/devpilot

# ---- Redis ----
REDIS_URL=redis://localhost:6380/0

# ---- Supabase Auth (setup: docs/AUTH.md) ----
# Project URL, e.g. https://abcdefgh.supabase.co  (public value)
SUPABASE_URL=
# Legacy HS256 projects only. New projects verify tokens via JWKS and don't need this.
SUPABASE_JWT_SECRET=

# ---- GitHub App (setup: docs/GITHUB.md) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Full path to the downloaded .pem private key. Keep that file OUTSIDE this repo.
GITHUB_APP_PRIVATE_KEY_PATH=

# ---- AI (setup: docs/AI.md) ----
# Model names are required and have no default: providers rename and retire models, so pick
# current ones from the provider's model list.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# Only needed if LLM_PROVIDER=anthropic. Claude Code does NOT need this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---- Asking questions about code (docs/ASK.md) ----
# ASK_TOP_K=12
# ASK_MAX_OUTPUT_TOKENS=8192
# ASK_RATE_LIMIT_PER_MINUTE=10

# ---- Background jobs and code indexing (docs/INDEXING.md) ----
# celery = jobs run on a worker (celery -A app.jobs.celery_app worker --pool=solo on Windows).
# inline = jobs run inside the API process: simple, but not restart-safe.
JOB_BACKEND=celery
# INDEX_EXCLUDE=docs/generated,*.snap
# INDEX_MAX_FILES=3000
# INDEX_MAX_CHUNKS=20000

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PRODUCT_NAME="DevPilot AI"
NEXT_PUBLIC_API_URL=http://localhost:8001
